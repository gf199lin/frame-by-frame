# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix these with VITE_.
# Vite would inline VITE_* values into the public JavaScript bundle.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_MS=45000

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://gf199lin.github.io

# Set to 1 only for local UI verification. The stub provider is NOT an AI model.
AI_PROVIDER=deepseek
ALLOW_STUB_PROVIDER=0
AI_DEBUG=0
PORT=8787

# ---------------------------------------------------------------------------
# Public client configuration. This is a URL, never a credential.
# Leave empty in production until the Worker URL is known.
# ---------------------------------------------------------------------------
VITE_AI_API_BASE=

# ---------------------------------------------------------------------------
# Supabase (public client values).
# Copy them into .env.local — never commit that file.
# The anon / publishable key is designed to be public; access control is
# enforced by Row Level Security, not by hiding this key.
# Never put the service_role / secret key here or anywhere under VITE_.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
