{
  "name": "frame-by-frame",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Frame by Frame — AI-Powered Personal Cinema Memory Museum",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --pretty false",
    "test": "npm run test:unit && npm run test:server",
    "test:unit": "vitest run",
    "test:server": "node --test server",
    "ai:dev": "node server/node.ts",
    "ai:verify": "node scripts/verify-ai.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "artwork:sync": "node scripts/sync-tmdb-artwork.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.5.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
